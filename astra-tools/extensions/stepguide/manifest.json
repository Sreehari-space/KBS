{
  "manifest_version": 3,
  "name": "StepGuide — Astra Tools",
  "version": "1.1.0",
  "description": "Record a browser workflow and turn it into an editable, branded how-to guide.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open StepGuide",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "tool.html?tool=stepguide",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}