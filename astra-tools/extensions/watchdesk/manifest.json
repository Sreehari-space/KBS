{
  "manifest_version": 3,
  "name": "WatchDesk — Astra Tools",
  "version": "1.1.0",
  "description": "Watch a selected price, stock message or page section and review confirmed changes.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "notifications",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open WatchDesk",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "tool.html?tool=watchdesk",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}